{
  "name": "arco-giwa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "stocks:container:build": "docker build --tag arco-giwa-api:local .",
    "stocks:container:check": "node scripts/stocks-deploy/check-image.mjs",
    "stocks:setup": "node scripts/stocks-local/owner.mjs setup",
    "stocks:doctor": "node scripts/stocks-local/owner.mjs check",
    "stocks:dev": "node scripts/stocks-local/owner.mjs start",
    "stocks:recovery:check": "node scripts/stocks-local/owner.mjs recovery",
    "stocks:integration:prepare": "node scripts/stocks-preflight/prepare-integration.mjs",
    "stocks:connection:check": "node scripts/stocks-preflight/check-connection.mjs",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "start:server": "npm run build:server && node server/dist/index.js",
    "build:giwa": "npm run build",
    "preview": "vite preview",
    "test": "npm run test:security && npm run test:server && npm run test:frontend",
    "test:security": "node scripts/security/check-env-exposure.mjs && node scripts/security/check-giwa-evm-version.mjs",
    "test:server": "npm run build:server && node --test \"server/dist/**/*.test.js\"",
    "test:frontend": "TMPDIR=/private/tmp node --import tsx --test \"src/demo/giwa/**/*.test.tsx\"",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "node scripts/prisma/generate.mjs",
    "prisma:migrate:deploy": "node scripts/prisma/migrate-deploy.mjs",
    "prisma:migration:inspect": "node scripts/prisma/inspect-migrations.mjs",
    "registry:generate:giwa": "npm run build:server && node scripts/registry/generate-giwa.mjs",
    "registry:validate:giwa": "npm run build:server && node scripts/registry/validate-giwa.mjs",
    "registry:sync:supabase": "npm run build:server && node scripts/registry/sync-supabase.mjs",
    "indexer:giwa": "npm run build:server && node scripts/indexer/run-giwa.mjs",
    "smoke:giwa": "npm run build:server && node scripts/smoke/giwa.mjs",
    "evm:build": "cd packages/contracts && corepack yarn compile",
    "evm:test": "cd packages/contracts && corepack yarn test",
    "evm:lint": "cd packages/contracts && corepack yarn lint:sol && corepack yarn format:sol",
    "evm:storage": "cd packages/contracts && corepack yarn storage:check",
    "evm:probe:giwa": "cd packages/contracts && corepack yarn probe:giwa",
    "evm:deploy:giwa:dry-run": "cd packages/contracts && corepack yarn deploy:giwa:dry-run",
    "evm:deploy:giwa": "cd packages/contracts && corepack yarn deploy:giwa",
    "evm:verify:giwa": "cd packages/contracts && corepack yarn verify:giwa",
    "design:tokens": "node .claude/hooks/check-design-tokens.mjs --all",
    "design:stories": "node .claude/hooks/check-story-exists.mjs --all",
    "qa:design": "npm run typecheck && npm run build && npm run design:tokens && npm run design:stories"
  },
  "dependencies": {
    "@dynamic-labs/ethereum": "4.91.2",
    "@dynamic-labs/sdk-react-core": "4.91.2",
    "@dynamic-labs/wagmi-connector": "4.91.2",
    "@fastify/cors": "^11.2.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/roboto-slab": "^5.2.8",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-query": "5.101.1",
    "@types/jsonwebtoken": "^9.0.10",
    "clsx": "^2.1.1",
    "fastify": "^5.8.5",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.460.0",
    "pg": "^8.22.0",
    "prisma": "^7.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.9.0",
    "siwe": "^3.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "viem": "2.53.1",
    "wagmi": "2.19.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.2.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
