# arco-giwa — environment template (NO REAL SECRETS HERE)
# Copy to .env (or .env.local) and fill in every bracketed value.
# Scopes are separated on purpose. Never put a secret behind VITE_*.
# Never commit a filled-in .env — the root .gitignore blocks .env* except this file.

# ─────────────────────────────────────────────────────────────
# SERVER-ONLY — Supabase Postgres via Prisma (shared Arco project)
# Project ref / host are placeholders. Get both from:
# Supabase dashboard → Connect → ORMs/Prisma. Replace every bracketed value.
# EVM tables live in the arco_evm schema; do NOT manage public.waitlist.
# ─────────────────────────────────────────────────────────────
# Transaction pooler (runtime), port 6543:
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:[PASSWORD]@aws-<N>-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session pooler / direct (migrations), port 5432:
DIRECT_URL="postgresql://postgres.<PROJECT_REF>:[PASSWORD]@aws-<N>-<region>.pooler.supabase.com:5432/postgres"

# ─────────────────────────────────────────────────────────────
# SERVER-ONLY — GIWA RPC for backend + indexer (Nodit)
# Key is embedded in the URL path → server secret. Rotate if exposed.
# ─────────────────────────────────────────────────────────────
INDEXER_RPC_URL="https://giwa-sepolia.nodit.io/<NODIT_KEY>"
INDEXER_RPC_WSS_URL="wss://giwa-sepolia.nodit.io/<NODIT_KEY>"   # optional
GIWA_CHAIN_ID="91342"
INDEXER_CONFIRMATIONS="5"        # confirmation blocks before indexing
INDEXER_MAX_BLOCK_RANGE="500"
INDEXER_POLL_INTERVAL_MS="5000"
INDEXER_START_BLOCK=""           # set to registry deploymentBlock
GIWA_REGISTRY_PATH="deployments/91342/arco-giwa-preprod.json"

# ─────────────────────────────────────────────────────────────
# SERVER-ONLY — backend config
# ─────────────────────────────────────────────────────────────
# PORT is the API server port. The Vite dev frontend is fixed at 5173 (see vite.config.ts) and
# must NOT reuse this PORT, or it collides with the API and drifts to a non-allowlisted origin.
PORT="8080"
# Explicit list, never "*". Must include the customer Vite dev origin (5173) and, to use the admin
# console locally, its dev origin (5174). SIWE sessions are accepted only for these hosts, so the
# admin console domain (e.g. https://admin.arco.financial) is added here, not in code.
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174"
AUTH_JWT_SECRET=""               # server-only session/JWT signing secret
AUTH_NONCE_TTL_SECONDS="300"     # SIWE nonce TTL (≤5 min)
# Vault admin operators (Savings/Funds admin routes). JSON array; wallet addresses are public, not
# secrets. Permissions: "vault:read" (GET) and "vault:write" (POST/PUT/DELETE; does not imply read).
# Unset or [] denies every Vault admin route. Stocks operators stay in the Stocks config JSON.
#   ADMIN_OPERATORS='[{"wallet":"0x…","operatorId":"ops-mike","permissions":["vault:read","vault:write"]}]'
ADMIN_OPERATORS=""
# Legacy shared token (x-operator-token). Refused unless ADMIN_LEGACY_TOKEN_AUTH=1; never accepted
# by the Stocks routes. Migration only — see docs/admin-console.md for the shutdown steps.
ADMIN_LEGACY_TOKEN_AUTH="0"
ADMIN_OPERATOR_TOKEN=""          # required only when ADMIN_LEGACY_TOKEN_AUTH=1; never VITE_*

# SERVER-ONLY — stock display data (does not enable orders)
STOCKS_MARKET_DATA_PROVIDER="MASSIVE" # MASSIVE | ALPACA
STOCKS_MARKET_DATA_CATALOG="PILOT"   # PILOT | CURATED_40
STOCKS_MARKET_DATA_FEED_DELAY="UNKNOWN"
MASSIVE_API_KEY=""                   # prices by default; profile/market cap/AUM enrichment in ALPACA mode
ALPACA_API_KEY_ID=""
ALPACA_API_SECRET_KEY=""
ALPACA_DATA_FEED="iex"              # iex: single exchange; sip: consolidated data entitlement required

# ─────────────────────────────────────────────────────────────
# FRONTEND-PUBLIC — safe to ship in the bundle (NOT secrets)
# ─────────────────────────────────────────────────────────────
VITE_PUBLIC_GIWA_RPC="https://sepolia-rpc.giwa.io"
VITE_GIWA_CHAIN_ID="91342"
VITE_GIWA_EXPLORER="https://sepolia-explorer.giwa.io"
VITE_DYNAMIC_ENVIRONMENT_ID=""   # Dynamic env id (public client id)
VITE_ARCO_API_BASE="http://localhost:8080"   # backend base URL
# Comma-separated wallet addresses that SEE the customer app's legacy /admin pages (visibility hint only).
# The admin console ignores it: access comes from the server (GET /api/v1/admin/session, ADMIN_OPERATORS).
VITE_GIWA_ADMIN_ADDRESSES=""
# Public URL of the separate admin console (e.g. https://admin.arco.financial), read at BUILD time. When set, the
# customer app's /admin, /admin/* and /admin/stocks redirect there and its bundle leaves the legacy admin pages out
# (confirm with `npm run check:customer-bundle` after the build). Unset keeps the legacy in-app admin (local demo).
VITE_ADMIN_CONSOLE_URL=""

# ─────────────────────────────────────────────────────────────
# DEPLOY / ADMIN — local only, never committed, never in CI logs
# Contracts are deployed through Hardhat scripts. The deployer must be a
# hardware/keystore-backed signer handled outside the repo; never place raw
# private keys here. Admin addresses are read from the network profile/registry,
# not hardcoded.
# ─────────────────────────────────────────────────────────────
DEPLOYER_KEYSTORE_ACCOUNT=""     # local signer alias; never a raw private key
TIER1_ADMIN_ADDRESS=""           # testnet: single hardware wallet (→ Safe on mainnet)
TIER2_OPERATOR_ADDRESS=""        # ops wallet that signs price/pause/fulfill
CONFIRM_GIWA_BROADCAST=""        # must be set explicitly to broadcast (deploy-time)

# ─────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────
FEATURE_XRPL_VAULT="false"       # keep legacy XRPL paths optional/off
LAUNCH_MODE="giwa-preprod"       # issuer | giwa-preprod | ethereum-*
